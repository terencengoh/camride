# Copy to supabase/functions/.env for local `supabase functions serve`,
# and set the same keys in production with `supabase secrets set --env-file supabase/functions/.env`.
# NEVER commit real values. SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Which adapter collects customer payments: campay | notchpay | cinetpay
PAYMENT_PROVIDER=campay
# Which adapter sends payouts and refunds (defaults to PAYMENT_PROVIDER)
PAYOUT_PROVIDER=campay

# CamPay (https://www.campay.net) - sandbox base URL shown; live: https://www.campay.net/api
# Payouts/refunds use /withdraw/: enable withdrawals for the app in the CamPay dashboard.
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=replace-with-app-username
CAMPAY_PASSWORD=replace-with-app-password
CAMPAY_WEBHOOK_KEY=replace-with-app-webhook-key

# Notch Pay (https://notchpay.co)
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=replace-with-public-key
NOTCHPAY_WEBHOOK_HASH=replace-with-webhook-hash-key
# Transfers (payouts/refunds) only: private key sent as X-Grant. Notch Pay requires the caller's IP
# to be whitelisted - Edge Functions have no fixed IP, so route transfers through a static-IP proxy.
NOTCHPAY_PRIVATE_KEY=replace-with-private-key

# CinetPay (https://cinetpay.com) - hosted checkout + Transfer API
CINETPAY_API_KEY=replace-with-api-key
CINETPAY_SITE_ID=replace-with-site-id
CINETPAY_SECRET_KEY=replace-with-secret-key
CINETPAY_NOTIFY_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/payments-webhook?provider=cinetpay
CINETPAY_RETURN_URL=https://YOUR-SITE/paid
CINETPAY_TRANSFER_PASSWORD=replace-with-transfer-api-password
CINETPAY_TRANSFER_NOTIFY_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/payments-webhook?provider=cinetpay

# Routing: OSRM base URL (self-hosted osrm-backend with Cameroon OSM extract). Empty = straight-line x1.3 estimate.
ROUTING_URL=
# Multiplier applied to OSRM car durations for local traffic
ROUTING_DURATION_FACTOR=1.25

# Expo push (optional; required only if "enhanced push security" is enabled in your Expo account)
EXPO_ACCESS_TOKEN=
