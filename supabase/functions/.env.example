# Copy to supabase/functions/.env for local `supabase functions serve`,
# and set the same keys in production with `supabase secrets set --env-file supabase/functions/.env`.
# NEVER commit real values. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Which adapter payments-initiate uses: campay | notchpay | cinetpay (stub)
PAYMENT_PROVIDER=campay

# CamPay (https://www.campay.net) - sandbox base URL shown; live: https://www.campay.net/api
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=replace-with-app-username
CAMPAY_PASSWORD=replace-with-app-password
CAMPAY_WEBHOOK_KEY=replace-with-app-webhook-key

# Notch Pay (https://notchpay.co)
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=replace-with-public-key
NOTCHPAY_WEBHOOK_HASH=replace-with-webhook-hash-key
