# Copy to .env (never commit .env). Public values only: the anon key is safe to ship in the app
# because Row Level Security protects the data. NEVER put the service-role key or payment keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Used at build time by app.config.ts (Android Google Maps SDK). Restrict it to package cm.camride.app + your SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key
# Optional: filled in by `eas init`
EAS_PROJECT_ID=
